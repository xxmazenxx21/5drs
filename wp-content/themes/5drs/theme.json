{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1280px"
		},
		"color": {
			"custom": true,
			"customGradient": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "primary", "color": "#0e3d4d", "name": "Navy" },
				{ "slug": "primary-hover", "color": "#0a313e", "name": "Navy dark" },
				{ "slug": "primary-soft", "color": "#e8f0f2", "name": "Navy tint" },
				{ "slug": "accent", "color": "#82ae61", "name": "Green" },
				{ "slug": "accent-strong", "color": "#4d6f35", "name": "Green dark" },
				{ "slug": "accent-soft", "color": "#edf0eb", "name": "Green tint" },
				{ "slug": "gold", "color": "#d0b572", "name": "Gold" },
				{ "slug": "canvas", "color": "#fbfbf9", "name": "Background" },
				{ "slug": "surface", "color": "#ffffff", "name": "Surface" },
				{ "slug": "surface-alt", "color": "#f5f8f9", "name": "Surface alt" },
				{ "slug": "ink", "color": "#0e3d4d", "name": "Text" },
				{ "slug": "ink-muted", "color": "#5a6b73", "name": "Muted text" },
				{ "slug": "line", "color": "#e3e6e2", "name": "Border" }
			]
		},
		"typography": {
			"customFontSize": true,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "sans",
					"name": "Montserrat (English)",
					"fontFamily": "Montserrat, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
				},
				{
					"slug": "arabic",
					"name": "Tajawal (Arabic)",
					"fontFamily": "Tajawal, system-ui, 'Noto Naskh Arabic', 'Segoe UI', Tahoma, sans-serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "size": "0.875rem", "name": "Small" },
				{ "slug": "medium", "size": "1rem", "name": "Medium" },
				{ "slug": "large", "size": "1.25rem", "name": "Large" },
				{ "slug": "x-large", "size": "1.75rem", "name": "Extra large" },
				{ "slug": "xx-large", "size": "2.25rem", "name": "Display" }
			]
		},
		"spacing": {
			"units": [ "px", "rem", "em", "%", "vw", "vh" ],
			"spacingSizes": [
				{ "slug": "10", "size": "0.5rem", "name": "1" },
				{ "slug": "20", "size": "1rem", "name": "2" },
				{ "slug": "30", "size": "1.5rem", "name": "3" },
				{ "slug": "40", "size": "2.5rem", "name": "4" },
				{ "slug": "50", "size": "4rem", "name": "5" },
				{ "slug": "60", "size": "5.5rem", "name": "6" }
			]
		},
		"border": {
			"radius": true,
			"color": true,
			"style": true,
			"width": true
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--canvas)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"lineHeight": "1.65"
		},
		"elements": {
			"link": {
				"color": { "text": "#1f6a84" }
			},
			"heading": {
				"color": { "text": "var(--wp--preset--color--ink)" },
				"typography": { "fontWeight": "700", "lineHeight": "1.2" }
			}
		}
	}
}
