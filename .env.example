# ------------------------------------------------------------------
# 5drs - local development environment
# Template. Copy to .env and fill in real values: cp .env.example .env
# ------------------------------------------------------------------

# Project
COMPOSE_PROJECT_NAME=5drs

# Host ports
WP_PORT=8080
PMA_PORT=8081
MAILPIT_PORT=8025

# Database
DB_NAME=5drs
DB_USER=5drs
DB_PASSWORD=changeme-generate-a-strong-password
DB_ROOT_PASSWORD=changeme-generate-a-strong-password
DB_HOST=db:3306
DB_TABLE_PREFIX=wp_

# WordPress site
WP_URL=http://localhost:8080
WP_TITLE=5drs
WP_LOCALE=en_US

# WordPress admin (generated - do not share)
WP_ADMIN_USER=5drs_admin
WP_ADMIN_EMAIL=you@example.com
WP_ADMIN_PASSWORD=changeme-generate-a-strong-password

# Mail (Mailpit, local only)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM=no-reply@5drs.local
MAIL_FROM_NAME=5drs
